{
  "name": "learning-deck",
  "type": "module",
  "version": "1.0.0",
  "description": "Learning Deck: learning keys for kids on Elgato Stream Deck (Windows)",
  "scripts": {
    "build": "node plugins/learning/gen.mjs && rollup -c",
    "test": "node tools/test-content.mjs && node tools/test-settings-panel.mjs && node plugins/learning/harness.mjs && node tools/clean.mjs",
    "test:ui": "node tools/test-settings-panel.mjs",
    "check:design": "node tools/check-design.mjs",
    "preview": "node tools/render-preview.mjs",
    "validate": "streamdeck validate plugins/learning/com.windowstoolkit.learning.sdPlugin",
    "pack": "node tools/clean.mjs && streamdeck pack plugins/learning/com.windowstoolkit.learning.sdPlugin --output dist --force",
    "build:installer": "node tools/build-installer.mjs",
    "test:installer": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/test-installer.ps1"
  },
  "keywords": [],
  "author": "Windows Toolkit",
  "license": "MIT",
  "devDependencies": {
    "@elgato/cli": "^1.10.2",
    "@elgato/streamdeck": "^3.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.20.5",
    "fflate": "^0.8.3",
    "rollup": "npm:@rollup/wasm-node@^4.64.12",
    "tslib": "^2.8.1",
    "typescript": "5.9"
  },
  "private": true
}
